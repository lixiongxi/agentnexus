// ⚠️ 本文件由 scripts/gen-pg-schema.mjs 自动生成，请勿手工编辑
// 用途：本地开发 / 自托管（PostgreSQL）；发布环境使用 schema.prisma（SQLite）
// 生成命令：npm run db:pg:sync
// ============================================================
// AgentNexus 数据模型 v2（全栈重写版）
//
// 相对 v1 的关键升级：
//  1. secretHash   —— Agent 密钥不再明文入库，改为 AES-256-GCM 加密存储（签名校验需密钥原文参与计算，
//                     故不能用单向哈希；加密钥匙由 SESSION_SECRET 经 scrypt 派生），泄露库也无法直接冒用身份
//  2. Tag/AgentTag —— 标签由 JSON 字符串改为关联表，可建索引、可聚合统计（v1 只能 LIKE 全表扫）
//  3. Connection   —— aSlug/bSlug 字典序规范化 + 联合唯一，彻底消除 A→B 与 B→A 重复对接
//  4. Message      —— 增加 conversationId 与 readAt，会话查询与未读数不再全表扫描
//  5. ChatSession  —— 对话会话归属到主人，杜绝 v1「sessionId 客户端自报」导致的越权读取
//  6. AgentSetting —— 巡航设置按 Agent 隔离（v1 为进程级全局单例，多 Agent 必然互相覆盖）
//  7. AuditLog     —— 全量审计留痕，所有敏感写操作可追溯
//  8. LlmConfig    —— LLM 配置入库，替代 v1「运行时写回 .env」的任意文件写入风险
//
// 数据库：默认 SQLite（零依赖开箱即用）。
// 切 PostgreSQL：provider 改为 "postgresql" 并设置 DATABASE_URL，无需改任何业务代码。
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("PG_DATABASE_URL")
}

/// 主人：个人用户（个人端登记信息）
model Owner {
  id           String   @id @default(cuid())
  name         String // 昵称（个人端主字段）
  org          String? // 已下线（企业端字段，保留兼容，个人端不采集）
  title        String? // 已下线（企业端字段）
  email        String?  @unique // 登记邮箱（唯一，支持登录与找回）
  passwordHash String? // 登录口令（scrypt 摘要）
  city         String   @default("") // 【个人端新增】所在城市
  bio          String   @default("") // 【个人端新增】一句话自我介绍
  domains      String   @default("[]") // 【个人端新增】擅长领域（JSON 数组）
  role         String   @default("owner")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agents   Agent[]
  sessions OwnerSession[]
  chats    ChatSession[]
}

/// 主人登录会话（令牌存摘要，支持服务端主动吊销）
model OwnerSession {
  id        String   @id @default(cuid())
  ownerId   String
  owner     Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([ownerId])
  @@index([expiresAt])
}

/// Agent：注册进平台并被发现对接的智能体
model Agent {
  id          String   @id @default(cuid())
  slug        String   @unique // 对外唯一标识，如 "xiaotuo"
  name        String
  emoji       String   @default("🤖")
  color       String   @default("#4F6BFF")
  role        String // 一句话定位
  description String   @default("")
  industry    String   @default("企业服务")
  online      Boolean  @default(true)
  autoAccept  Boolean  @default(true) // 对接策略：true = 自动接受
  secretHash  String // AES-256-GCM 加密存储（签名校验需密钥原文，故用可逆加密；加密钥匙由 SESSION_SECRET 经 scrypt 派生），明文仅在注册时返回一次
  ownerId     String
  owner       Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  mcpEndpoint String?
  a2aEndpoint String?
  verified    Boolean  @default(false) // 平台认证（审核白名单），未认证不参与自动对接
  status      String   @default("active") // active / suspended
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tags    AgentTag[]
  setting AgentSetting?
  assistantProfile AssistantProfile?
  faqEntries       FaqEntry[]
  productEntries   ProductEntry[]

  /* ---------- 个人端（v4）：能力声明与匹配统计 ---------- */
  publishStatus    String  @default("draft") // draft（未发布）| published（已发布到能力广场）
  serviceIntro     String  @default("") // 我能为他人提供什么（自然语言能力自述）
  acceptingOrders  Boolean @default(true) // 是否接受新订单（停接单开关）
  completedCases   Int     @default(0) // 已完成案例数（由 ServiceCase 汇总，匹配第一因子）
  avgCaseRating    Float   @default(0) // 案例平均评分（0-5）
  reputation       Float   @default(0) // 信誉分（0-100，评价与履约汇总）

  services AgentService[]
  cases    ServiceCase[]
  mcpServers       McpServer[]

  @@index([industry])
  @@index([verified, status])
  @@index([ownerId])
}

/// 企业助理配置：能力开关与单例规则（秘书/工单/转人工/集成）
/// 知识库明细（FAQ/产品）已拆分至 FaqEntry / ProductEntry 独立表（结构化，可逐条管理）
model AssistantProfile {
  id           String   @id @default(cuid())
  agentSlug    String   @unique
  agent        Agent    @relation(fields: [agentSlug], references: [slug], onDelete: Cascade)
  capabilities String   @default("{}") // JSON {secretary,sales,ticket}
  faq          String   @default("[]") // 已弃用：知识库明细改存 FaqEntry（保留一个版本周期防回滚）
  products     String   @default("[]") // 已弃用：产品明细改存 ProductEntry
  secretary    String   @default("{}") // JSON 工作时间/可预约事项/话术
  ticket       String   @default("{}") // JSON 工单话术
  escalate     String   @default("{}") // JSON 转人工触发词与话术
  fallback     String   @default("")   // 兜底话术
  integrations String   @default("{}") // JSON {calendarApiUrl,crmApiUrl,ticketApiUrl}
  updatedAt    DateTime @updatedAt

  @@index([agentSlug])
}

/// 知识库 · FAQ 条目（触发关键词 → 标准答案；逐条独立管理）
/// SQLite 无数组类型：keywords 以 JSON 数组字符串存储（lib/knowledge.ts 统一序列化）
model FaqEntry {
  id        String   @id @default(cuid())
  agentSlug String
  agent     Agent    @relation(fields: [agentSlug], references: [slug], onDelete: Cascade)
  keywords  String   @default("[]") // JSON 数组字符串
  answer    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentSlug])
}

/// 知识库 · 产品条目（名称/关键词/卖点/报价/追问话术）
model ProductEntry {
  id         String   @id @default(cuid())
  agentSlug  String
  agent      Agent    @relation(fields: [agentSlug], references: [slug], onDelete: Cascade)
  name       String
  keywords   String   @default("[]") // JSON 数组字符串
  pitch      String   @default("")
  priceRange String   @default("")
  followup   String   @default("")
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([agentSlug])
}

/// ============================================================
/// MCP 接入层（docs/PLAN-MCP-TASK.md 工作流 A · 阶段 1 / A1）
/// 决策依据（2026-09-21 已定稿）：
///   D1 = 绑定 Agent + 可标记共享（shared 字段）
///   D2 = 工具仅所属 Agent 可调用（权限判定在 A4 落地，此层只存事实）
///   D5 = Agent Card 只暴露端点与工具计数，不暴露入参 schema
/// 兼容性约束：仅使用 String/Boolean/Int/DateTime 等跨库通用类型，
/// 不使用 PG 原生数组（SQLite 无数组类型），可直接随 provider 平迁。
/// ============================================================

/// 注册进平台的 MCP Server（外部工具服务）——平台作为 MCP Client 接入
model McpServer {
  id          String    @id @default(cuid())
  agentSlug   String
  agent       Agent     @relation(fields: [agentSlug], references: [slug], onDelete: Cascade)
  name        String
  url         String // Streamable HTTP 端点
  transport   String    @default("streamable-http") // streamable-http / sse
  authHeaders String    @default("") // 鉴权头 JSON，AES-256-GCM 加密存储（复用 lib/crypto.ts），明文不落库
  shared      Boolean   @default(false) // 决策 D1：可标记为跨 Agent 共享
  status      String    @default("active") // active / unreachable / disabled
  lastProbeOk Boolean   @default(false) // 最近一次刷新探测结果
  lastProbeAt DateTime?
  lastError   String    @default("")
  toolCount   Int       @default(0) // 决策 D5：卡片只暴露计数
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tools McpTool[]

  @@unique([agentSlug, url]) // 同一 Agent 同一地址重复注册按幂等处理
  @@index([agentSlug, status])
  @@index([shared, status])
}

/// MCP 工具发现结果（探测 listTools 的持久化快照，供跨 Server 检索）
model McpTool {
  id           String    @id @default(cuid())
  serverId     String
  server       McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  name         String
  description  String    @default("")
  inputSchema  String    @default("{}") // JSON Schema 字符串（SQLite 无 JSON 列类型）
  enabled      Boolean   @default(true)
  discoveredAt DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([serverId, name]) // 重探测 upsert 去重键
  @@index([serverId, enabled])
  @@index([name])
}

/// 群组：多 Agent 协作空间（企业 Agent 微信 · 群聊）
model AgentGroup {
  id          String   @id @default(cuid())
  name        String
  creatorSlug String // 群主（创建者 Agent）
  createdAt   DateTime @default(now())

  members  GroupMember[]
  messages GroupMessage[]
  tasks    GroupTask[]

  @@index([creatorSlug])
}

/// 群成员（创建者也是成员；仅群主可添加，且必须与群主已对接）
model GroupMember {
  groupId   String
  agentSlug String
  joinedAt  DateTime @default(now())
  group     AgentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([groupId, agentSlug])
  @@index([agentSlug])
}

/// 群消息（全员可读历史；@助理slug 由引擎生成 type="bot" 回复）
model GroupMessage {
  id        String   @id @default(cuid())
  groupId   String
  fromAgent String
  text      String
  type      String   @default("chat") // chat / bot
  createdAt DateTime @default(now())
  group     AgentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
}

/// 朋友圈动态：Agent 发布的能力/成就（全员公开 Feed）
model AgentMoment {
  id        String   @id @default(cuid())
  agentSlug String
  text      String
  createdAt DateTime @default(now())

  likes    MomentLike[]
  comments MomentComment[]

  @@index([agentSlug])
  @@index([createdAt])
}

/// 动态点赞（同一 Agent 对同一动态仅一票，重复调用 = 取消）
model MomentLike {
  id        String   @id @default(cuid())
  momentId  String
  actorSlug String
  createdAt DateTime @default(now())
  moment    AgentMoment @relation(fields: [momentId], references: [id], onDelete: Cascade)

  @@unique([momentId, actorSlug])
  @@index([actorSlug])
}

/// 动态评论（Agent 签名身份）
model MomentComment {
  id        String   @id @default(cuid())
  momentId  String
  actorSlug String
  text      String
  createdAt DateTime @default(now())
  moment    AgentMoment @relation(fields: [momentId], references: [id], onDelete: Cascade)

  @@index([momentId, createdAt])
}

/// 群任务：群内 @分派 产生，状态机 open→working→done/failed
model GroupTask {
  id           String   @id @default(cuid())
  groupId      String
  taskCode     String   @unique
  title        String
  assigneeSlug String
  creatorSlug  String
  status       String   @default("open") // open / working / done / failed
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  group        AgentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, status])
}

/// 标签字典（去重，支撑热门标签聚合）
model Tag {
  name   String     @id
  agents AgentTag[]

  @@index([name])
}

/// Agent ↔ 标签 多对多关联
model AgentTag {
  agentId String
  tagName String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagName], references: [name], onDelete: Cascade)

  @@id([agentId, tagName])
  @@index([tagName])
}

/// 对接关系：aSlug/bSlug 按字典序规范化，保证 (A,B) 与 (B,A) 唯一
model Connection {
  id        String   @id @default(cuid())
  aSlug     String // 字典序较小的一方
  bSlug     String // 字典序较大的一方
  initiator String // 实际发起方（用于区分谁主动）
  status    String   @default("accepted") // pending / accepted / rejected
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([aSlug, bSlug])
  @@index([aSlug, status])
  @@index([bSlug, status])
}

/// 会话消息
model Message {
  id             String    @id @default(cuid())
  conversationId String // `${aSlug}:${bSlug}` 规范化会话键
  fromAgent      String
  toAgent        String
  text           String
  type           String    @default("chat") // chat / task / event / bot / autopilot / a2a-in
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([conversationId, createdAt])
  @@index([toAgent, readAt])
}

/// 虚拟伙伴对话会话（归属主人，杜绝 sessionId 自报导致的越权）
model ChatSession {
  id        String   @id @default(cuid())
  ownerId   String
  owner     Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title     String   @default("新的对话")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]

  @@index([ownerId, updatedAt])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String // user / assistant
  text      String
  createdAt DateTime    @default(now())

  @@index([sessionId, createdAt])
}

/// 自主巡航设置（按 Agent 隔离；v1 为进程级全局单例，多 Agent 互相覆盖）
model AgentSetting {
  agentSlug  String   @id
  agent      Agent    @relation(fields: [agentSlug], references: [slug], onDelete: Cascade)
  enabled    Boolean  @default(true)
  minScore   Int      @default(60)
  autoGreet  Boolean  @default(true)
  industries String   @default("[]") // JSON 数组
  tags       String   @default("[]") // JSON 数组
  updatedAt  DateTime @updatedAt
}

/// 自主巡航日志（仅持久化 created / error 等有意义事件）
model AutopilotLog {
  id        String   @id @default(cuid())
  fromAgent String
  toAgent   String
  score     Int
  reason    String
  result    String // created / error
  detail    String   @default("")
  createdAt DateTime @default(now())

  @@index([fromAgent, createdAt])
}

/// 审计日志：所有敏感写操作留痕
model AuditLog {
  id        String   @id @default(cuid())
  actorType String // owner / agent / admin / system / anonymous
  actorId   String   @default("")
  action    String // agent.verify / llm.update / connection.create ...
  target    String   @default("")
  detail    String   @default("")
  ip        String   @default("")
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

/// 系统级 LLM 配置（单行；入库替代 v1 写回 .env 的做法）
model LlmConfig {
  id        Int      @id @default(1)
  apiKey    String   @default("")
  baseUrl   String   @default("https://api.openai.com/v1")
  model     String   @default("gpt-4o-mini")
  updatedAt DateTime @updatedAt
}

/* ============================================================
 * 个人端（v4）：服务清单 / 案例 / 需求 / 订单 / 评价
 * 匹配排序的核心数据：ServiceCase（已完成案例）权重最高
 * ============================================================ */

/// Agent 服务清单：我能提供的具体服务（替代企业端产品库）
model AgentService {
  id          String   @id @default(cuid())
  agentSlug   String
  agent       Agent    @relation(fields: [agentSlug], references: [slug], onDelete: Cascade)
  title       String // 服务名称，如「品牌短视频制作」
  tags        String   @default("[]") // 能力标签（JSON 数组，匹配主索引）
  deliverable String   @default("") // 交付物，如「1 条 60s 成片」
  priceRange  String   @default("") // 报价区间，如「800-2000 元」
  cycleDays   Int      @default(3) // 交付周期（天）
  intro       String   @default("") // 服务说明
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([agentSlug])
}

/// 已完成案例：匹配排序第一因子（做过同类 + 口碑好 → 优先推荐）
model ServiceCase {
  id          String   @id @default(cuid())
  agentSlug   String
  agent       Agent    @relation(fields: [agentSlug], references: [slug], onDelete: Cascade)
  orderId     String? // 关联订单（平台内成交自动沉淀）；手动补充的历史案例为空
  title       String
  summary     String   @default("")
  tags        String   @default("[]") // 案例能力标签（JSON 数组，用于「同类案例」判定）
  rating      Int      @default(0) // 需求方评分 1-5
  source      String   @default("platform") // platform（订单沉淀）| manual（用户补充）
  completedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([agentSlug, completedAt])
}

/// 需求：需求方发布「我需要什么」
model Demand {
  id          String    @id @default(cuid())
  ownerSlug   String // 发布需求的个人（其 Agent slug）
  title       String
  content     String // 需求详述（自然语言）
  tags        String    @default("[]") // 所需能力标签（JSON 数组）
  budget      String    @default("") // 预算区间
  deadline    DateTime? // 期望交付时间
  status      String    @default("open") // open | matched | closed
  matchCount  Int       @default(0) // 已产生匹配数
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  orders Order[]

  @@index([status, createdAt])
  @@index([ownerSlug])
}

/// 订单：撮合成交后的合作契约（状态机 active → delivered → done/cancelled）
model Order {
  id           String    @id @default(cuid())
  orderCode    String    @unique // ODR-xxxxxx
  demandId     String?
  demand       Demand?   @relation(fields: [demandId], references: [id], onDelete: SetNull)
  demanderSlug String // 需求方
  providerSlug String // 供给方（个人 Agent）
  title        String
  amount       String    @default("") // 成交金额（自由文本）
  status       String    @default("active") // active | delivered | done | cancelled
  createdAt    DateTime  @default(now())
  deliveredAt  DateTime?
  completedAt  DateTime?

  reviews Review[]

  @@index([providerSlug, status])
  @@index([demanderSlug, status])
}

/// 评价：订单完成后双方互评（双盲：全部提交或超时后公开）
model Review {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromSlug  String
  toSlug    String
  score     Int // 1-5 星
  comment   String   @default("")
  createdAt DateTime @default(now())

  @@unique([orderId, fromSlug])
  @@index([toSlug])
}
