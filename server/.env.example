# ============================================================
# AgentNexus 服务端配置（复制为 .env 后按需修改）
# 安全说明：本文件不应提交到版本库；生产环境所有 *_SECRET / *_TOKEN 必须替换
# ============================================================

# ---- 服务 ----
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# ---- 数据库（SQLite 零依赖起步；切 PG 只需改此行 + schema provider） ----
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require"

# ---- 安全（核心） ----
# strict = Agent 写操作必须携带 HMAC 签名（生产/招商环境强制）
# demo   = 无签名放行，仅限本地演示，上线前必须改回 strict
AUTH_MODE=strict

# 管理员令牌：所有 /api/admin/* 端点必需（请求头 X-Admin-Token）
# 生产环境务必替换为高强度随机值，例如 `openssl rand -hex 32`
ADMIN_TOKEN="dev-admin-token-please-change"

# 主人会话令牌签名密钥（HMAC-SHA256）
SESSION_SECRET="dev-session-secret-please-change"

# CORS 允许的来源，逗号分隔；* 表示不限制（仅开发环境可用）
CORS_ORIGIN="*"

# 反向代理层数（影响限流识别到的真实客户端 IP，0 = 直连）
TRUST_PROXY=0

# ---- 限流 ----
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# ---- 虚拟伙伴 LLM（可选） ----
# 也可在前端「协议设置」页在线配置，配置存库而非写回本文件
# LLM_API_KEY=""
# LLM_BASE_URL="https://api.openai.com/v1"
# LLM_MODEL="gpt-4o-mini"

# ---- 自主巡航 ----
AUTOPILOT_ENABLED=true
AUTOPILOT_INTERVAL_MS=1200000
AUTOPILOT_LOG_KEEP=300
