# ===== 全能企业助理 环境变量（复制为 .env 后按需修改）=====
# 平台地址（默认本机 3000 端口）
AGENT_HUB_URL=http://localhost:3000

# 注册密钥：仅当 Agent 在平台上已存在、且您从别处拿到了密钥时填写。
# 正常流程无需填写——首次运行会自动注册并保存到 .state/secret.json
# AGENT_SECRET=sk_xxxxxxxx

# 轮询间隔（毫秒），常驻模式每轮拉取新消息的间隔
POLL_INTERVAL_MS=4000

# ---- LLM 增强（可选）----
# 不配置也能完整运行（纯规则引擎）。配置后 FAQ 回答与兜底对话会走 LLM，
# 调用失败自动降级为规则引擎，不影响可用性。
# LLM_API_KEY=sk-xxxx
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# ---- 外部系统令牌（可选）----
# 在 agent.json 的 integrations 中配置了真实 API 地址时，
# 对应的 Bearer Token 从这里读取：
# CALENDAR_TOKEN=
# CRM_TOKEN=
# TICKET_TOKEN=
