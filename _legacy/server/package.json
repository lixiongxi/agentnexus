{
  "name": "agenthub-server",
  "version": "0.1.0",
  "description": "AgentNexus M0 - Agent 注册与发现服务 (TS + Fastify + Prisma)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "db:push": "prisma db push",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx scripts/seed.ts",
    "test:frontend": "node scripts/frontend-regression.mjs",
    "test:ui": "node scripts/ui-enhancement-test.cjs",
    "test:all": "node scripts/frontend-regression.mjs && node scripts/ui-enhancement-test.cjs"
  },
  "prisma": {
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/websocket": "^11.3.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@prisma/client": "^6.2.1",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "fastify": "^5.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
