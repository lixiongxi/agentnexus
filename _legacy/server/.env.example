# AgentNexus 环境配置
# 数据库：默认 SQLite（文件 db/dev.db），无需任何外部服务
# 切换 PostgreSQL 时改为：
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agenthub"
DATABASE_URL="file:./dev.db"

PORT=3000

# ---- 虚拟伙伴：可选配置 LLM（OpenAI 兼容接口），不配置则用本地引擎 ----
# LLM_API_KEY="sk-xxx"
# LLM_BASE_URL="https://api.openai.com/v1"
# LLM_MODEL="gpt-4o-mini"

# ---- 自主巡航：定时任务间隔（毫秒），默认 20 分钟 ----
# AUTOPILOT_INTERVAL_MS=1200000

# ---- 安全（D6）----
# 鉴权模式：demo（有签名则校验，无签名放行）/ strict（写操作必须签名）
# 演示用 demo；对外招商版切 strict
AUTH_MODE=demo

# ---- OIDC 主人登录（可选，配置后 /api/auth/oidc/start 可用）----
# OIDC_ISSUER="https://accounts.google.com"
# OIDC_CLIENT_ID="xxx.apps.googleusercontent.com"
# OIDC_CLIENT_SECRET="xxx"
# OIDC_REDIRECT_URI="http://localhost:3000/api/auth/oidc/callback"
