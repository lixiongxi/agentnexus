/* 全局样式：与 Web/桌面/移动端保持同一设计语言（品牌色 #4F6BFF、卡片式、12px 圆角） */
page {
  background: #f6f8fc;
  color: #16213a;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", sans-serif;
}

.page {
  padding: 20rpx 24rpx 40rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(22, 33, 58, 0.04);
}

.row {
  display: flex;
  align-items: center;
}
.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.grow {
  flex: 1;
  min-width: 0;
}
.muted {
  color: #98a1b5;
  font-size: 24rpx;
}
.sub {
  color: #6b7590;
  font-size: 26rpx;
}
.bold {
  font-weight: 600;
}
.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 头像 */
.avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  background: #edf1ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}
.avatar-sm {
  width: 60rpx;
  height: 60rpx;
  font-size: 30rpx;
  border-radius: 18rpx;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 40rpx;
  background: #edf1ff;
  color: #4f6bff;
  font-size: 22rpx;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
}
.badge-verified {
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: #e3f7ec;
  color: #178a50;
  font-size: 20rpx;
  margin-left: 8rpx;
}

/* 按钮 */
.btn {
  background: #4f6bff;
  color: #fff;
  border-radius: 20rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
}
.btn.plain {
  background: #fff;
  color: #4f6bff;
  border: 2rpx solid #dbe3ff;
}
.btn.danger {
  background: #fff;
  color: #b3382c;
  border: 2rpx solid #f3d6d3;
}
.btn[disabled] {
  opacity: 0.5;
}
.btn-sm {
  height: 64rpx;
  line-height: 64rpx;
  font-size: 24rpx;
  padding: 0 24rpx;
  display: inline-block;
}

/* 输入 */
.input {
  background: #fbfcfe;
  border: 2rpx solid #e6eaf2;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}
.input-label {
  font-size: 24rpx;
  color: #6b7590;
  margin-bottom: 10rpx;
}

/* 空态 */
.empty {
  padding: 140rpx 60rpx;
  text-align: center;
  color: #98a1b5;
}
.empty-emoji {
  font-size: 88rpx;
  display: block;
  margin-bottom: 20rpx;
}

/* 徽标/状态 */
.pill {
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
}
.pill-open { background: #fdf3e4; color: #c07d1c; }
.pill-working { background: #e6f3fb; color: #1f7ba8; }
.pill-done { background: #e3f7ec; color: #178a50; }
.pill-failed { background: #fdeceb; color: #c0392b; }

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #c3cad8;
  display: inline-block;
}
.dot.on {
  background: #2db578;
}

/* 会话气泡 */
.bubble-wrap {
  display: flex;
  margin-bottom: 24rpx;
}
.bubble-wrap.mine {
  justify-content: flex-end;
}
.bubble {
  max-width: 76%;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: #fff;
  border: 2rpx solid #e6eaf2;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-all;
}
.bubble.mine {
  background: #4f6bff;
  color: #fff;
  border: none;
}
.bubble.bot {
  background: #eef7f4;
  border-color: #d6ece4;
}
.bubble-meta {
  font-size: 20rpx;
  color: #98a1b5;
  margin-top: 8rpx;
}
.bubble.mine .bubble-meta {
  color: rgba(255, 255, 255, 0.75);
}

/* 底部输入条 */
.input-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-top: 2rpx solid #eef1f6;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.input-bar .input {
  margin-bottom: 0;
  flex: 1;
}
.send-btn {
  width: 128rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 18rpx;
  background: #4f6bff;
  color: #fff;
  font-size: 28rpx;
}

.safe-bottom {
  height: 180rpx;
}
