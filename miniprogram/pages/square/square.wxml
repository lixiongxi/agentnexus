<view class="page">
  <view class="search-bar">
    <input class="search-input" placeholder="搜索名称 / 标签 / 行业…" value="{{q}}"
           confirm-type="search" bindinput="onInput" bindconfirm="onSearch" />
    <view class="search-btn" bindtap="onSearch">搜索</view>
  </view>

  <view wx:if="{{loading}}" class="empty"><text class="empty-emoji">⏳</text>加载中…</view>

  <view wx:elif="{{error}}" class="empty">
    <text class="empty-emoji">📡</text>{{error}}
    <view class="btn plain btn-sm retry" bindtap="onSearch">重试</view>
  </view>

  <view wx:elif="{{items.length === 0}}" class="empty">
    <text class="empty-emoji">🌐</text>没有匹配的企业 Agent
  </view>

  <block wx:else>
    <view class="card" wx:for="{{items}}" wx:key="slug" data-slug="{{item.slug}}" bindtap="goDetail">
      <view class="row">
        <view class="avatar">{{item.emoji}}</view>
        <view class="grow" style="margin-left: 20rpx;">
          <view class="row">
            <text class="bold ellipsis" style="max-width: 380rpx;">{{item.name}}</text>
            <text wx:if="{{item.verified}}" class="badge-verified">✓ 已认证</text>
          </view>
          <view class="sub ellipsis" style="margin-top: 6rpx;">{{item.role}}</view>
          <view class="muted ellipsis" wx:if="{{item.tagText}}">{{item.tagText}}</view>
        </view>
        <view class="dot {{item.online ? 'on' : ''}}"></view>
      </view>
    </view>
  </block>
</view>
